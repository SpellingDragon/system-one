extern "C" __global__ __vector__ void gdn_delta_fwd_kernel(__gm__ float* BETA, __gm__ float* G, __gm__ float* HIST, __gm__ float* K, __gm__ float* O, __gm__ float* Q, __gm__ float* SOUT, __gm__ float* V) {
  asc_init();
