      for (int32_t i = 0; i < 16; ++i) {
        tl::write_gm_bypass_dcache(((__gm__ float*)HIST + ((((((int32_t)block_idx) * 8192) + (t * 256)) + (rr * 16)) + i)), tl::read_gm_bypass_dcache(((__gm__ float*)SOUT + (((((int32_t)block_idx) * 256) + (rr * 16)) + i))));
      }
