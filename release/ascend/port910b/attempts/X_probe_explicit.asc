// X_probe_explicit.asc — 探针3：3101 显式形（与 tilelang IR 逐词同名）在 2201 是否可编
// 复跑: bisheng --npu-arch=dav-2201 -std=c++20 -c X_probe_explicit.asc -o /tmp/x_exp.o
// 若报 "not visible/undeclared overload" → 2201 不吃该形；若可编 → 与探针2 对比 asm
#include <cstdint>

#ifndef TL_PORT910B_NATIVE_TYPES
#define TL_PORT910B_NATIVE_TYPES
#endif
#include "port910b_compat.h"

__aicore__ inline void probe_call(__ca__ bfloat16_t *dst, __cbuf__ bfloat16_t *src) {
  // 3101.h:3022 显式形：(dst,src,mStartPosition,kStartPosition,mStep,kStep,srcStride,dstStride,transpose)
  load_cbuf_to_ca(dst, src, (uint16_t)0, (uint16_t)1, (uint8_t)2, (uint8_t)3,
                  (int16_t)16, (uint16_t)16, false);
}

__kernel__ void x_probe_explicit() {
  __cbuf__ bfloat16_t *s = reinterpret_cast<__cbuf__ bfloat16_t *>(1024);
  __ca__ bfloat16_t *d = reinterpret_cast<__ca__ bfloat16_t *>(0);
  probe_call(d, s);
}
