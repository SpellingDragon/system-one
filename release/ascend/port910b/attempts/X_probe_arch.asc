// X_probe_arch.asc — p2-13 P1-1j 探针1：dav-2201 下 __NPU_ARCH__ 真值与 3101 头可见性
// 复跑: bisheng --npu-arch=dav-2201 -std=c++20 -c X_probe_arch.asc -o /tmp/x_arch.o
__kernel__ void x_arch_probe() {
#ifdef CCE_AICORE_INTRINSICS_TYPES_3101
  // 若可见：__NPU_ARCH__ 打印在编译错误文本里
  static_assert(__NPU_ARCH__ == 3101, "XARCH: __NPU_ARCH__=3101 (3101 header INCLUDED)");
#else
  static_assert(__NPU_ARCH__ == -12345, "XARCH: 3101 header NOT included");
#endif
}
