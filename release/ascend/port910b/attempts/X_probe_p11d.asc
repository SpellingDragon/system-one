// X_probe_p11d.asc — 探针2：现 §12（P1-1d 九参形）的调用在 2201 是否可编
// 复跑: bisheng --npu-arch=dav-2201 -std=c++20 -c X_probe_p11d.asc -o /tmp/x_p11d.o
#include <cstdint>

#ifndef TL_PORT910B_NATIVE_TYPES
#define TL_PORT910B_NATIVE_TYPES
#endif
#include "port910b_compat.h"

__aicore__ inline void probe_call(__ca__ bfloat16_t *dst, __cbuf__ bfloat16_t *src) {
  // 与 trunk §12 asc_copy_l12l0a 完全同形（P1-1d 9 参）
  load_cbuf_to_ca(dst, src, (uint16_t)0, (uint8_t)1, (uint16_t)16,
                  (uint16_t)0, (uint8_t)0, false,
                  (__cce_scalar::addr_cal_mode_t)0);
}

__kernel__ void x_probe_p11d() {
  __cbuf__ bfloat16_t *s = reinterpret_cast<__cbuf__ bfloat16_t *>(1024);
  __ca__ bfloat16_t *d = reinterpret_cast<__ca__ bfloat16_t *>(0);
  probe_call(d, s);
}
